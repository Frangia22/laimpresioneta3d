<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    <main class="auth-shell">
        <div class="auth-card bg-violet-500">
        <% if (successMessage || errorMessage) { %>
            <div class="flex shadow-lg rounded-xl mb-6 overflow-hidden ring-1 ring-black/10" id="alert" role="alert">
                    <% if (successMessage) { %>
                    <div class="bg-green-600 py-4 px-4 shrink-0 flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6 text-white" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <% } else if(errorMessage) { %>
                        <div class="bg-red-600 py-4 px-4 shrink-0 flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="fill-current text-white" width="20" height="20"><path fill-rule="evenodd" d="M4.47.22A.75.75 0 015 0h6a.75.75 0 01.53.22l4.25 4.25c.141.14.22.331.22.53v6a.75.75 0 01-.22.53l-4.25 4.25A.75.75 0 0111 16H5a.75.75 0 01-.53-.22L.22 11.53A.75.75 0 010 11V5a.75.75 0 01.22-.53L4.47.22z"></path></svg>
                        </div>
                    <% } %>
                <div class="px-4 py-4 bg-white flex justify-between items-center gap-3 flex-1 min-w-0">
                    <% if (successMessage) { %>
                    <p class="text-sm font-medium text-gray-900"><%= successMessage %></p>
                    <% } else if(errorMessage) { %>
                        <% if (errorMessage == 'Missing credentials') { %>
                            <p class="text-sm font-semibold text-red-700">Completá correo y contraseña.</p>
                        <% } else { %>
                            <p class="text-sm font-semibold text-red-700"><%= errorMessage %></p>
                        <% } %>
                    <% } %>
                    <button type="button" onclick="hideMessage()" class="shrink-0 p-1 rounded-lg hover:bg-gray-100 text-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow" aria-label="Cerrar mensaje">
                        <svg xmlns="http://www.w3.org/2000/svg" class="fill-current" viewBox="0 0 16 16" width="20" height="20"><path fill-rule="evenodd" d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"></path></svg>
                    </button>
                </div>
            </div>
            <% } %>
        <form id="jwt-login-form" class="form-stack" method="post" action="#">
            <h1 class="auth-card-title">Iniciar sesión</h1>
            <p class="form-hint text-center -mt-1 mb-1">Acceso al panel con la API v1 (JWT). No usás el POST legacy <code class="text-yellow/90 text-xs">/singin</code>.</p>
            <div>
                <label for="email" class="form-label">Correo electrónico</label>
                <input id="email" name="email" type="email" class="form-control" placeholder="nombre@ejemplo.com" autocomplete="email" required>
            </div>
            <div>
                <label for="password" class="form-label">Contraseña</label>
                <div class="relative">
                    <input id="password" name="password" type="password" class="form-control pr-11" autocomplete="current-password" required>
                    <button type="button" id="iconChange" class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center rounded-lg text-violet hover:bg-violet/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow ri-eye-line" aria-label="Mostrar u ocultar contraseña" aria-controls="password" aria-pressed="false"></button>
                </div>
            </div>
            <p class="auth-footer-link">¿No estás registrado? <a href="/singup">Crear cuenta</a></p>
            <button type="submit" id="jwt-login-submit" name="submit" class="btn-primary mt-2">Ingresar</button>
        </form>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>
    <script src="/javascript/effects.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('jwt-login-form');
        if (!form || !window.LaimpresionetaApi) return;
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          var btn = document.getElementById('jwt-login-submit');
          var email = document.getElementById('email').value.trim();
          var password = document.getElementById('password').value;
          if (btn) { btn.disabled = true; }
          try {
            await window.LaimpresionetaApi.login(email, password);
            var me = await window.LaimpresionetaApi.me();
            if (!me) throw new Error('No se pudo obtener el perfil');
            if (Number(me.roleId) === 1) {
              window.location.href = '/dashboard';
            } else {
              window.location.href = '/';
            }
          } catch (err) {
            if (window.LaimpresionetaUi && window.LaimpresionetaUi.toast) {
              window.LaimpresionetaUi.toast(err.message || 'Error de login', 'error');
            } else {
              alert(err.message || 'Error de login');
            }
          } finally {
            if (btn) { btn.disabled = false; }
          }
        });
      });
    </script>
</body>
</html>
