<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    <section class="bg-violet-500 lg:w-1/2 mx-auto my-10 lg:absolute lg:top-1/4 lg:left-1/4">
        <% if (successMessage || errorMessage) { %>
            <div class="flex lg:w-1/2 mx-auto shadow-lg rounded-lg mt-4" id="alert">
                    <% if (successMessage) { %>
                    <div class="bg-green-600 py-4 px-6 rounded-l-lg flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <% } else if(errorMessage) { %>
                        <div class="bg-red-600 py-4 px-6 rounded-l-lg flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="fill-current text-white" width="20" height="20"><path fill-rule="evenodd" d="M4.47.22A.75.75 0 015 0h6a.75.75 0 01.53.22l4.25 4.25c.141.14.22.331.22.53v6a.75.75 0 01-.22.53l-4.25 4.25A.75.75 0 0111 16H5a.75.75 0 01-.53-.22L.22 11.53A.75.75 0 010 11V5a.75.75 0 01.22-.53L4.47.22zm.84 1.28L1.5 5.31v5.38l3.81 3.81h5.38l3.81-3.81V5.31L10.69 1.5H5.31zM8 4a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 018 4zm0 8a1 1 0 100-2 1 1 0 000 2z"></path></svg>
                        </div>
                    <% } %>
                <div class="px-4 py-6 bg-white rounded-r-lg flex justify-between items-center w-full border border-l-transparent border-gray-200">
                    <% if (successMessage) { %>
                    <div><%= successMessage %></div>
                    <% } else if(errorMessage) { %>
                    <div>
                        <% if (errorMessage == 'Missing credentials') { %>
                            <p class="text-yellow-500 text-center">Complete los campos</p>
                        <% } else { %>
                            <p class="text-yellow-500 text-center"><%= errorMessage %></p>
                        <% } %>
                    </div>
                    <% } %>
                    <button type="submit" onclick="hideMessage()">
                        <svg xmlns="http://www.w3.org/2000/svg" class="fill-current text-gray-700" viewBox="0 0 16 16" width="20" height="20"><path fill-rule="evenodd" d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"></path></svg>
                    </button>
                </div>
            </div>
            <% } %>
        <form id="jwt-login-form" class="w-1/2 mx-auto p-4" method="post" action="#">
            <h1 class="text-yellow text-2xl text-center">Iniciar sesión</h1>
            <p class="text-xs text-gray-200 text-center mt-2">El acceso al panel usa la API v1 con JWT (sin <code class="text-yellow-200">POST /singin</code>).</p>
            <div class="relative">
                <label for="email" class="flex flex-col py-2">
                    Correo electronico
                    <input id="email" name="email" type="text" class="rounded-2xl py-2 px-4 my-2 font-sans" placeholder="Correo electronico" autocomplete="email" required>
                </label>
            </div>            
            <label for="password" class="flex flex-col py-2">
                Contraseña
                <div class="flex flex-row-reverse relative">
                    <input id="password" name="password" type="password" class="rounded-2xl py-2 px-4 my-2 w-full font-sans" autocomplete="current-password" required>
                    <i id="iconChange" class="absolute right-3 top-1/2 -translate-y-1/2 ri-eye-line cursor-pointer" tabindex="0" role="button" aria-label="Mostrar u ocultar contraseña"></i>
                </div>
            </label>
            <p class="py-2 text-sm text-gray-300 hover:underline hover:text-black">No estas registrado? <a class="hover:text-yellow-500" href="/singup">Registrarse</a></p>
            <button type="submit" id="jwt-login-submit" name="submit" class="bg-yellow-500 py-2 px-6 rounded-xl mt-2 font-bold text-violet hover:text-white">Ingresar</button>
        </form>
    </section>
    <%- include('../partials/footer.ejs') %>
    <script src="/javascript/effects.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('jwt-login-form');
        if (!form || !window.LaimpresionetaApi) return;
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          var btn = document.getElementById('jwt-login-submit');
          var email = document.getElementById('email').value.trim();
          var password = document.getElementById('password').value;
          if (btn) { btn.disabled = true; }
          try {
            await window.LaimpresionetaApi.login(email, password);
            var me = await window.LaimpresionetaApi.me();
            if (!me) throw new Error('No se pudo obtener el perfil');
            if (Number(me.roleId) === 1) {
              window.location.href = '/dashboard';
            } else {
              window.location.href = '/';
            }
          } catch (err) {
            if (window.LaimpresionetaUi && window.LaimpresionetaUi.toast) {
              window.LaimpresionetaUi.toast(err.message || 'Error de login', 'error');
            } else {
              alert(err.message || 'Error de login');
            }
          } finally {
            if (btn) { btn.disabled = false; }
          }
        });
      });
    </script>
</body>
</html>
