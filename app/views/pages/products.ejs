<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    <section class="w-full bg-transparent pb-12">
        <div class="section-readable py-8 md:py-10">
            <h1 class="section-readable-title text-3xl md:text-4xl font-extrabold text-center text-yellow px-4">Productos</h1>
            <p class="text-center text-white/90 text-sm md:text-base mt-3 max-w-xl mx-auto px-4">Catálogo completo. Abrí cualquier ficha para ver más y coordinar la compra.</p>
        </div>
        <div id="products-list-root" class="md:flex justify-around flex-row flex-wrap gap-4 px-2 md:px-4">
            <p class="panel-muted text-center w-full max-w-md mx-auto py-10 px-4 font-medium">Cargando productos…</p>
        </div>
        <div id="productModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black bg-opacity-75 p-4" role="dialog" aria-modal="true" aria-labelledby="productName">
            <div class="bg-gray-100 bg-opacity-95 rounded shadow-lg p-6 w-full max-w-3xl max-h-[90vh] overflow-y-auto" data-product-modal-panel>
                <div class="flex flex-row-reverse justify-between items-center gap-2 mb-2">
                    <button type="button" class="text-5xl leading-none bg-transparent border-0 cursor-pointer text-violet hover:text-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-500 ri-close-line" id="productModalClose" aria-label="Cerrar detalle del producto"></button>
                    <h2 id="productName" class="text-2xl font-semibold pr-2"></h2>
                    </div>
                    <div class="lg:flex rounded-lg bg-transparent">
                    <img class="rounded-t-lg lg:rounded-l-lg w-full lg:w-1/2 lg:h-96 object-contain bg-white" id="productImage" alt="" />
                <div class="p-6 rounded-b-lg rounded-none lg:rounded-r-lg bg-violet-500 lg:w-1/2 lg:flex lg:flex-col lg:justify-around">
                    <p id="productPrice" class="mb-2 text-xl font-medium leading-tight text-white"></p>
                    <ul id="productDescription" class="my-4 list-none p-0"></ul>
                    <a id="textBtn" class="block rounded bg-yellow px-6 pb-2 pt-2.5 text-sm text-center font-bold text-violet hover:text-white hover:bg-[#390097] transition-colors"></a>
                    <button type="button" id="textBtnOutOfStock" class="hidden w-full rounded bg-red-400 px-6 pb-2 pt-2.5 text-sm text-center font-bold text-white cursor-not-allowed opacity-90" disabled>Sin stock</button>
                </div>
                </div>
            </div>
        </div>
    </section>
    <%- include('../partials/footer.ejs') %>
    <script src="/javascript/details.js"></script>
    <script src="/javascript/page-products.js" defer></script>
</body>
</html>
