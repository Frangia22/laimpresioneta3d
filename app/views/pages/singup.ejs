<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    <main class="auth-shell">
        <div class="auth-card bg-violet-500">
        <% if (errorMessages && errorMessages.length > 0) { %>
            <div class="rounded-xl mb-6 overflow-hidden shadow-lg ring-1 ring-red-500/30 bg-white" id="alert" role="alert">
                <div class="px-4 py-4 flex justify-between items-start gap-3">
                    <ul class="flex-1 min-w-0 space-y-2">
                        <% errorMessages.forEach(function (errorMessage) { %>
                          <li class="text-sm font-medium text-red-800 flex gap-2 items-start">
                            <i class="ri-alarm-warning-line text-red-600 text-lg shrink-0 mt-0.5" aria-hidden="true"></i>
                            <span><%= errorMessage %></span>
                          </li>
                        <% }); %>
                    </ul>
                  <button type="button" id="closeAlert" class="shrink-0 p-1 rounded-lg hover:bg-gray-100 text-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow" aria-label="Cerrar mensajes">
                    <svg xmlns="http://www.w3.org/2000/svg" class="fill-current" viewBox="0 0 16 16" width="20" height="20"><path fill-rule="evenodd" d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"></path></svg>
                  </button>
                </div>
              </div>
              <% } %>
        <form action="/singUpUsers" class="form-stack" method="post">
            <h1 class="auth-card-title">Crear cuenta</h1>
            <p class="form-hint text-center -mt-1 mb-1">Completá los datos para registrarte. Si ya tenés cuenta, iniciá sesión.</p>
            <div class="form-grid-2">
                <div class="sm:col-span-2">
                    <label for="nombre" class="form-label">Nombre</label>
                    <input id="nombre" type="text" name="nombre" placeholder="Tu nombre" value="<%= data.nombre || '' %>" class="form-control" autocomplete="name" required>
                </div>
                <div class="sm:col-span-2">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <input id="email" type="email" name="email" value="<%= data.email || '' %>" class="form-control" placeholder="nombre@ejemplo.com" autocomplete="email" required>
                </div>
            </div>
            <div>
                <label for="password" class="form-label">Contraseña</label>
                <div class="relative">
                    <input id="password" type="password" name="password" value="<%= data.password || '' %>" class="form-control pr-11" autocomplete="new-password" required>
                    <button type="button" id="iconChange" class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center rounded-lg text-violet hover:bg-violet/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow ri-eye-line" aria-label="Mostrar u ocultar contraseña" aria-pressed="false"></button>
                </div>
            </div>
            <p class="auth-footer-link">¿Ya estás registrado? <a href="/admin">Iniciar sesión</a></p>
            <button type="submit" class="btn-primary">Registrarse</button>
        </form>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>
    <script src="/javascript/effects.js"></script>
</body>
</html>
