<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    <% if (title) { %>
    <% if (title == "Agregar producto") { %>
        <%- include('../forms/addProduct.ejs') %>
    <% }else if (title == "Agregar servicio") { %>
        <%- include('../forms/addService.ejs') %>
    <% }else if (title == "Categorias") { %>
        <%- include('../forms/addCategory.ejs') %>
    <% }else { %>
        <h1>Lo siento no encontramos dicho formulario</h1>
    <% } %>
    <% } %>
    <%- include('../partials/footer.ejs') %> 
    <script>
        const footer = document.querySelector('footer');
        footer.classList.remove('sticky', 'top-[100vh]');
        function hideMessage() {
            const alert = document.getElementById('alert');
            if (alert) alert.classList.add('hidden');
        }
    </script>
    <% if (title === "Agregar producto") { %>
    <script src="/javascript/auth-guard.js" defer></script>
    <script src="/javascript/page-add-product.js" defer></script>
    <% } else if (title === "Agregar servicio") { %>
    <script src="/javascript/auth-guard.js" defer></script>
    <script src="/javascript/page-add-service.js" defer></script>
    <% } else if (title === "Categorias") { %>
    <script src="/javascript/auth-guard.js" defer></script>
    <script src="/javascript/page-categories.js" defer></script>
    <% } %>
</body>
</html>