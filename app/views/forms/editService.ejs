<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    <script>window.__EDIT_SERVICE_ID__ = <%= Number(service.id) %>;</script>
    <section class="bg-violet-500 lg:w-1/2 mx-auto my-10">
        <form id="edit-service-form" class="w-1/2 mx-auto p-4" method="post" action="#">
            <label for="nombre" class="flex flex-col py-2">
                Nombre
                <input id="nombre" type="text" value="" name="name" placeholder="Nombre del servicio" class="rounded-2xl py-2 px-4 my-2 font-sans" autocomplete="name" required>
            </label>     
            <label for="iconService" class="flex flex-col py-2">
                Ruta icono servicio
                <div class="flex flex-row-reverse">
                    <input id="iconService" type="text" value="" placeholder="../images/sinImagen.svg" name="iconService" class="rounded-2xl py-2 px-4 my-2 w-full font-sans" autocomplete="off" required>
                </div>
            </label>
            <label for="details" class="flex flex-col py-2">
                Detalles
                <div class="flex flex-row-reverse">
                    <textarea id="details" type="text" placeholder="Ingrese los detalles" name="details" class="rounded-2xl py-2 px-4 my-2 w-full font-sans" autocomplete="off" cols="15" rows="3" required></textarea>
                </div>
            </label>
            <button type="submit" class="bg-yellow-500 py-2 px-6 rounded-xl mt-2 font-bold text-violet hover:text-white mx-auto flex">Editar Servicio</button>
        </form>
    </section>
<%- include('../partials/footer.ejs') %> 
    <script src="/javascript/auth-guard.js" defer></script>
    <script src="/javascript/page-edit-service.js" defer></script>
    <script>
        const footer = document.querySelector('footer');
        footer.classList.remove('sticky', 'top-[100vh]');
    </script>   
</body>
</html>
