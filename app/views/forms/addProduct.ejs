<main class="admin-form-shell">
<section class="admin-form-card bg-violet-500">
    <% if (errorMessages) { %>
        <div class="flex shadow-lg rounded-xl mb-8 overflow-hidden ring-1 ring-black/10" id="alert" role="alert">
                <% if(errorMessages) { %>
                    <div class="bg-red-600 py-4 px-4 shrink-0 flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="fill-current text-white" width="20" height="20"><path fill-rule="evenodd" d="M4.47.22A.75.75 0 015 0h6a.75.75 0 01.53.22l4.25 4.25c.141.14.22.331.22.53v6a.75.75 0 01-.22.53l-4.25 4.25A.75.75 0 0111 16H5a.75.75 0 01-.53-.22L.22 11.53A.75.75 0 010 11V5a.75.75 0 01.22-.53L4.47.22z"></path></svg>
                    </div>
                <% } %>
            <div class="px-4 py-4 bg-white flex justify-between items-start gap-3 flex-1 min-w-0">
                <%  if(errorMessages && errorMessages.length > 0) { %>
                    <ul class="space-y-2 flex-1">
                        <% errorMessages.forEach(function (errorMessage) { %>
                          <li class="text-sm font-medium text-red-800 flex gap-2 items-start">
                            <i class="ri-alarm-warning-line text-red-600 shrink-0 mt-0.5" aria-hidden="true"></i>
                            <span><%= errorMessage %></span>
                          </li>
                        <% }); %>
                    </ul>
                <% } %>
                <button type="button" onclick="hideMessage()" class="shrink-0 p-1 rounded-lg hover:bg-gray-100 text-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow" aria-label="Cerrar mensaje">
                    <svg xmlns="http://www.w3.org/2000/svg" class="fill-current" viewBox="0 0 16 16" width="20" height="20"><path fill-rule="evenodd" d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"></path></svg>
                </button>
            </div>
        </div>
        <% } %>
    <h1 class="admin-form-title">Agregar producto</h1>
    <p class="admin-form-subtitle">Los detalles pueden separarse con punto y coma (;). La imagen es una ruta bajo <code class="text-yellow/90">/public</code> (ej. <code class="text-yellow/90">../images/sinImagen.svg</code>).</p>
    <form id="add-product-form" class="form-stack" method="post" action="#">
        <div class="form-grid-2">
            <div>
                <label for="nombre" class="form-label">Nombre</label>
                <input id="nombre" value="<%= data && data.name ? data.name : '' %>" type="text" name="name" placeholder="Nombre del producto" class="form-control" autocomplete="name" required>
            </div>
            <div>
                <label for="price" class="form-label">Precio</label>
                <input id="price" value="<%= data && data.price ? data.price : '' %>" type="number" name="price" min="0" step="1" class="form-control" placeholder="1500" autocomplete="off" required>
            </div>
        </div>
        <div>
            <label for="image" class="form-label">Ruta de imagen</label>
            <input id="image" value="<%= data && data.image ? data.image : '' %>" type="text" placeholder="../images/sinImagen.svg" name="image" class="form-control" autocomplete="off" required>
        </div>
        <div>
            <label for="details" class="form-label">Detalles</label>
            <textarea id="details" placeholder="Separá cada bullet con ;" name="details" class="form-control" autocomplete="off" rows="4" required><%= data && data.details ? data.details : '' %></textarea>
        </div>
        <div class="form-grid-2">
            <div>
                <label for="linkPago" class="form-label">Link de pago <span class="font-normal text-white/70">(opcional)</span></label>
                <input id="linkPago" value="<%= data && data.linkPago ? data.linkPago : '' %>" type="url" name="linkPago" class="form-control" placeholder="https://…" autocomplete="off">
            </div>
            <div>
                <label for="idCategory" class="form-label">Categoría</label>
                <select name="idCategory" id="idCategory" class="form-control" required>
                    <option value="">Cargando categorías…</option>
                </select>
            </div>
        </div>
        <div>
            <label for="otherDetails" class="form-label">Otros detalles <span class="font-normal text-white/70">(opcional)</span></label>
            <textarea id="otherDetails" placeholder="Separá con ;" name="otherDetails" class="form-control" autocomplete="off" rows="3"><%= data && data.otherDetails ? data.otherDetails : '' %></textarea>
        </div>
        <div class="admin-actions-row pt-2">
            <a href="/products" class="btn-secondary-light">Volver al catálogo</a>
            <button type="submit" class="btn-primary">Guardar producto</button>
        </div>
    </form>
</section>
</main>
