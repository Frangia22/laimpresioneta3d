<!DOCTYPE html>
<html lang="es">
    <%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    <script>window.__EDIT_PRODUCT_ID__ = <%= Number(product.id) %>;</script>
<main class="admin-form-shell">
<section class="admin-form-card bg-violet-500">
    <h1 class="admin-form-title">Editar producto</h1>
    <p class="admin-form-subtitle">Modificá los campos y guardá. ID actual: <strong class="text-yellow"><%= product.id %></strong>.</p>
    <form id="edit-product-form" class="form-stack" method="post" action="#">
        <div class="form-grid-2">
            <div>
                <label for="nombre" class="form-label">Nombre</label>
                <input id="nombre" type="text" name="name" value="" placeholder="Nombre del producto" class="form-control" autocomplete="name" required>
            </div>
            <div>
                <label for="price" class="form-label">Precio</label>
                <input id="price" type="number" name="price" value="" min="0" step="1" class="form-control" placeholder="1500" autocomplete="off" required>
            </div>
        </div>
        <div>
            <label for="image" class="form-label">Ruta de imagen</label>
            <input id="image" type="text" placeholder="../images/sinImagen.svg" value="" name="image" class="form-control" autocomplete="off" required>
        </div>
        <div>
            <label for="details" class="form-label">Detalles</label>
            <textarea id="details" placeholder="Separá cada bullet con ;" name="details" class="form-control" autocomplete="off" rows="4" required></textarea>
        </div>
        <div class="form-grid-2">
            <div>
                <label for="linkPago" class="form-label">Link de pago <span class="font-normal text-white/70">(opcional)</span></label>
                <input id="linkPago" type="url" name="linkPago" value="" class="form-control" placeholder="https://…" autocomplete="off">
            </div>
            <div>
                <label for="idCategory" class="form-label">Categoría</label>
                <select name="idCategory" id="idCategory" class="form-control" required>
                    <option value="">Cargando…</option>
                </select>
            </div>
        </div>
        <div>
            <label for="otherDetails" class="form-label">Otros detalles <span class="font-normal text-white/70">(opcional)</span></label>
            <textarea id="otherDetails" placeholder="Separá con ;" name="otherDetails" class="form-control" autocomplete="off" rows="3"></textarea>
        </div>
        <div class="admin-actions-row pt-2">
            <a href="/products" class="btn-secondary-light">Volver al catálogo</a>
            <button type="submit" class="btn-primary">Actualizar producto</button>
        </div>
    </form>
</section>
</main>
<%- include('../partials/footer.ejs') %> 
    <script src="/javascript/auth-guard.js" defer></script>
    <script src="/javascript/page-edit-product.js" defer></script>
    <script>
        const footer = document.querySelector('footer');
        if (footer) footer.classList.remove('sticky', 'top-[100vh]');
    </script>   
</body>
</html>
