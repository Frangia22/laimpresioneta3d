<!DOCTYPE html>
<html lang="es">
  <%- include('./partials/head.ejs') %>
  <body>
    <%- include('./partials/header.ejs') %>
    <%- include('./partials/nav.ejs') %>
    <% 
      var waPhone = String(publicContact.whatsappPhone || '').replace(/\D/g, '');
      var waPresupuesto = 'https://api.whatsapp.com/send?phone=' + encodeURIComponent(waPhone) + '&text=' + encodeURIComponent('Hola, quiero pedir un presupuesto para impresión 3D / grabado láser.');
      var waConsulta = 'https://api.whatsapp.com/send?phone=' + encodeURIComponent(waPhone) + '&text=' + encodeURIComponent('Hola, tengo una consulta sobre sus servicios.');
    %>
    <section class="w-full min-h-[30em] bg-portada hero-portada flex flex-col items-center justify-center px-4 py-16">
      <div class="hero-portada-inner flex flex-col items-center gap-8 max-w-3xl">
        <h1 class="text-yellow text-3xl md:text-4xl lg:text-5xl font-extrabold text-center leading-tight tracking-tight drop-shadow-lg">Transformando ideas en realidad, con impresión 3D y grabado láser</h1>
        <p class="text-white text-center text-base md:text-lg font-medium opacity-95 max-w-xl drop-shadow-md">Modelos, piezas personalizadas y grabado láser. Contanos tu proyecto y te asesoramos.</p>
        <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4 w-full">
          <a href="<%= waPresupuesto %>" rel="noopener noreferrer" target="_blank" class="u-cta-yellow inline-flex items-center justify-center rounded-2xl px-8 py-3.5 text-lg md:text-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow w-full sm:w-auto text-center">Pedir presupuesto por WhatsApp</a>
          <a href="/#contact" class="u-cta-outline inline-flex items-center justify-center rounded-2xl px-8 py-3.5 text-lg md:text-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow w-full sm:w-auto text-center">Otros medios de contacto</a>
        </div>
      </div>
    </section>
    <section id="service" class="w-full xl:h-30em bg-violet pb-12">
      <h2 class="text-4xl text-center text-yellow py-10">Servicios</h2>
      <% if (message) { %>
        <div class="flex lg:w-1/2 mx-auto shadow-lg rounded-lg" id="alert">
          <% if (message == "Servicio editado con exito!!" || message == "Servicio eliminado con exito!!" || message == "Servicio agregado con exito!!") { %>
            <div class="bg-green-600 py-4 px-6 rounded-l-lg flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
              <% }else{ %>
            <div class="bg-red-600 py-4 px-6 rounded-l-lg flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="fill-current text-white" width="20" height="20"><path fill-rule="evenodd" d="M4.47.22A.75.75 0 015 0h6a.75.75 0 01.53.22l4.25 4.25c.141.14.22.331.22.53v6a.75.75 0 01-.22.53l-4.25 4.25A.75.75 0 0111 16H5a.75.75 0 01-.53-.22L.22 11.53A.75.75 0 010 11V5a.75.75 0 01.22-.53L4.47.22zm.84 1.28L1.5 5.31v5.38l3.81 3.81h5.38l3.81-3.81V5.31L10.69 1.5H5.31zM8 4a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 018 4zm0 8a1 1 0 100-2 1 1 0 000 2z"></path></svg>
            </div>
              <% } %>
          <div class="px-4 py-6 bg-white rounded-r-lg flex justify-between items-center w-full border border-l-transparent border-gray-200">
            <div><%= message %></div>
            <button type="button" onclick="hideMessage()">
              <svg xmlns="http://www.w3.org/2000/svg" class="fill-current text-gray-700" viewBox="0 0 16 16" width="20" height="20"><path fill-rule="evenodd" d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"></path></svg>
            </button>
          </div>
        </div>
      <% } %>
      <div id="home-services-root" class="md:flex justify-around flex-row">
        <p class="text-center text-white w-full py-6">Cargando servicios…</p>
      </div>
    </section>
    <section class="w-full bg-transparent pb-8">
      <div class="section-readable py-8 md:py-10 mb-2">
        <h2 class="section-readable-title text-3xl md:text-4xl font-extrabold text-center text-yellow px-4">Productos</h2>
        <p class="text-center text-white/90 text-sm md:text-base mt-3 max-w-xl mx-auto px-4">Seleccioná un item para ver detalles y comprar por WhatsApp.</p>
      </div>
      <div id="home-products-root" class="md:flex justify-around flex-row flex-wrap gap-4 px-2 md:px-4">
        <p class="panel-muted text-center w-full max-w-md mx-auto py-8 px-4 font-medium">Cargando productos…</p>
      </div>
      <div id="productModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black bg-opacity-75 p-4" role="dialog" aria-modal="true" aria-labelledby="productName">
        <div class="bg-gray-100 bg-opacity-95 rounded shadow-lg p-6 w-full max-w-3xl max-h-[90vh] overflow-y-auto" data-product-modal-panel>
            <div class="flex flex-row-reverse justify-between items-center gap-2 mb-2">
                <button type="button" class="text-5xl leading-none bg-transparent border-0 cursor-pointer text-violet hover:text-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-500 ri-close-line" id="productModalClose" aria-label="Cerrar detalle del producto"></button>
                <h2 id="productName" class="text-2xl font-semibold pr-2"></h2>
                </div>
                <div class="lg:flex rounded-lg bg-transparent">
                <img class="rounded-t-lg lg:rounded-l-lg lg:w-1/2 h-44 w-full lg:h-96 object-contain bg-white" id="productImage" alt="" />
                <div class="p-6 rounded-b-lg rounded-none lg:rounded-r-lg bg-violet-500 lg:w-1/2 lg:flex lg:flex-col lg:justify-around">
                    <p id="productPrice" class="mb-2 text-xl font-medium leading-tight text-white"></p>
                    <ul id="productDescription" class="my-4 list-none p-0"></ul>
                    <a id="textBtn" class="block rounded bg-yellow px-6 pb-2 pt-2.5 text-sm text-center font-bold text-violet hover:text-white hover:bg-[#390097] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow"></a>
                    <button type="button" id="textBtnOutOfStock" class="hidden w-full rounded bg-red-400 px-6 pb-2 pt-2.5 text-sm text-center font-bold text-white cursor-not-allowed opacity-90" disabled>Sin stock</button>
                </div>
            </div>
        </div>
      </div>
      <a href="/products" class="u-cta-yellow block mx-auto my-10 w-fit rounded-2xl px-10 py-4 text-xl md:text-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow text-center">Ver catálogo completo</a>
    </section>
    <section id="contact" class="w-full md:h-30em bg-violet pb-12">
      <h2 class="text-4xl text-center text-yellow py-10">Contacto</h2>
      <p class="text-center text-white/90 max-w-2xl mx-auto px-4 pb-6">Elegí el canal que prefieras. Respondemos lo antes posible.</p>
      <div class="md:columns-3 justify-around flex-row">
        <div class="basis-1/4">
          <div class="flex-col text-center bg-transparent py-12">
            <img class="mx-auto py-4" src="../images/mailIcon.svg" alt="" aria-hidden="true">
            <p class="w-3/4 mx-auto text-white mb-4">Escribinos por correo con tu idea o archivos adjuntos.</p>
            <a href="mailto:<%= publicContact.email %>?subject=Consulta%20impresión%203D" class="inline-block rounded-3xl bg-yellow px-6 py-2 text-lg font-semibold text-violet hover:text-white hover:bg-violet-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow">Enviar correo</a>
          </div>
        </div>
        <div class="basis-1/4 rounded-xl">
          <div class="flex-col text-center bg-transparent py-12">
            <img class="mx-auto py-4" src="../images/whatsappIcon.svg" alt="" aria-hidden="true">
            <p class="w-3/4 mx-auto text-white mb-4">Chateá con nosotros para presupuestos rápidos y consultas.</p>
            <a href="<%= waConsulta %>" rel="noopener noreferrer" target="_blank" class="inline-block rounded-3xl bg-yellow px-6 py-2 text-lg font-semibold text-violet hover:text-white hover:bg-violet-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow">Abrir WhatsApp</a>
          </div>
        </div>
        <div class="basis-1/4 rounded-xl">
          <div class="flex-col text-center bg-transparent py-12">
            <img class="mx-auto py-4" src="../images/instagramIcon.svg" alt="" aria-hidden="true">
            <p class="w-3/4 mx-auto text-white mb-4">Seguinos y mirá trabajos recientes y novedades.</p>
            <a href="<%= publicContact.instagramUrl %>" rel="noopener noreferrer" target="_blank" class="inline-block rounded-3xl bg-yellow px-6 py-2 text-lg font-semibold text-violet hover:text-white hover:bg-violet-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow">Ver Instagram</a>
          </div>
        </div>
      </div>
    </section>
    <%- include('./partials/footer.ejs') %>
    <script src="/javascript/effects.js"></script>
    <script src="/javascript/details.js"></script>
    <script src="/javascript/page-home.js" defer></script>
  </body>
</html>
